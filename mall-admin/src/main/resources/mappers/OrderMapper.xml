<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.mapper.OrderMapper">

    <resultMap id="OrderMap" type="com.mall.entity.Order">
        <id property="id" column="id"/>
        <result property="orderNo" column="order_no"/>
        <result property="userId" column="user_id"/>
        <result property="addressId" column="address_id"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="payAmount" column="pay_amount"/>
        <result property="status" column="status"/>
        <result property="payTime" column="pay_time"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="nickname" column="nickname"/>
        <result property="phone" column="phone"/>
    </resultMap>

    <resultMap id="OrderDetailMap" type="com.mall.entity.Order" extends="OrderMap">
        <association property="user" javaType="com.mall.entity.CUser">
            <id property="id" column="u_id"/>
            <result property="nickname" column="u_nickname"/>
            <result property="phone" column="u_phone"/>
        </association>
        <association property="address" javaType="com.mall.entity.Address">
            <id property="id" column="a_id"/>
            <result property="receiver" column="a_receiver"/>
            <result property="phone" column="a_phone"/>
            <result property="province" column="a_province"/>
            <result property="city" column="a_city"/>
            <result property="district" column="a_district"/>
            <result property="detail" column="a_detail"/>
        </association>
    </resultMap>

    <select id="pageByQuery" resultMap="OrderMap">
        SELECT o.*, u.nickname, u.phone
        FROM `order` o
        LEFT JOIN c_user u ON o.user_id = u.id
        <where>
            <if test="query.orderNo != null and query.orderNo != ''">
                AND o.order_no LIKE CONCAT('%', #{query.orderNo}, '%')
            </if>
            <if test="query.phone != null and query.phone != ''">
                AND u.phone LIKE CONCAT('%', #{query.phone}, '%')
            </if>
            <if test="query.status != null">
                AND o.status = #{query.status}
            </if>
            <if test="query.startDate != null and query.startDate != ''">
                AND DATE(o.create_time) &gt;= #{query.startDate}
            </if>
            <if test="query.endDate != null and query.endDate != ''">
                AND DATE(o.create_time) &lt;= #{query.endDate}
            </if>
        </where>
        ORDER BY o.id DESC
    </select>

    <select id="selectDetail" resultMap="OrderDetailMap">
        SELECT o.*,
               u.id AS u_id, u.nickname AS u_nickname, u.phone AS u_phone,
               a.id AS a_id, a.receiver AS a_receiver, a.phone AS a_phone,
               a.province AS a_province, a.city AS a_city, a.district AS a_district, a.detail AS a_detail
        FROM `order` o
        LEFT JOIN c_user u ON o.user_id = u.id
        LEFT JOIN address a ON o.address_id = a.id
        WHERE o.id = #{id}
    </select>

    <select id="dailySales" resultType="java.util.Map">
        SELECT DATE(create_time) AS date,
               COALESCE(SUM(pay_amount), 0) AS amount,
               COUNT(*) AS cnt
        FROM `order`
        WHERE status IN (2, 3)
        <if test="startDate != null and startDate != ''">
            AND DATE(create_time) &gt;= #{startDate}
        </if>
        <if test="endDate != null and endDate != ''">
            AND DATE(create_time) &lt;= #{endDate}
        </if>
        GROUP BY DATE(create_time)
        ORDER BY date ASC
    </select>

    <select id="statusDistribution" resultType="java.util.Map">
        SELECT status, COUNT(*) AS cnt FROM `order` GROUP BY status
    </select>

</mapper>
